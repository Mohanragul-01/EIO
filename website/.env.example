# Same Supabase project as the phone app, different variable names because
# Vite only exposes variables prefixed with VITE_ to the browser.
#
# The anon key is NOT a secret - it ships in the client either way, and what
# actually protects your data is Row Level Security. Never put a service_role
# key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
