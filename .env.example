# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# EXPO_PUBLIC_ is required: Expo only exposes variables with that prefix to the
# app bundle. These values are public by design — data is protected by Row
# Level Security, not by hiding the anon key. Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
